# Local Postman configuration; Spring Boot reads this as UTF-8 Java properties.
# Do not add "export" or surround values with quotes. Double any backslash in a value.
# Keep .env private; share only .env.example with its password left blank.
spring.profiles.active=supabase

# Fill this in locally with the Supabase DATABASE password, not an API key.
SUPABASE_DB_PASSWORD=

# Local HTTP session cookies. Use true for HTTPS deployment.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Postman testing must not apply migrations or start collection jobs.
FLYWAY_ENABLED=false
spring.jpa.hibernate.ddl-auto=validate
compass.recruit.import-enabled=false
compass.recruit.crawl.enabled=false
compass.activity.collect.enabled=false

spring.main.web-application-type=servlet
server.address=127.0.0.1
server.port=8080

# Optional API docs: enable only on a trusted development deployment.
API_DOCS_ENABLED=false
# Local form demo; the shared IntelliJ run configuration enables it locally.
DEMO_ENABLED=false
# Development only. Enables the authenticated basic-info reset API.
STUDENT_BASIC_RESET_ENABLED=false
# Gmail: use a dedicated sender and app password, not your Google account password.
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
